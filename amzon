<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Ecommerce Store</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        /* HEADER */
        header {
            background-color: #232f3e;
            color: white;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        header h1 {
            margin: 0;
        }

        .search-box input {
            padding: 8px;
            width: 300px;
        }

        /* NAVBAR */
        nav {
            background-color: #37475a;
            padding: 10px;
            color: white;
        }

        nav a {
            color: white;
            margin-right: 15px;
            text-decoration: none;
        }

        /* PRODUCT GRID */
        .products {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            padding: 20px;
        }

        .product {
            border: 1px solid #ccc;
            padding: 15px;
            text-align: center;
        }

        .product img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .product button {
            background-color: #f0c14b;
            border: none;
            padding: 8px;
            cursor: pointer;
        }

        /* FOOTER */
        footer {
            background-color: #232f3e;
            color: white;
            padding: 20px;
            text-align: center;
        }
    </style>
</head>
<body>

<header>
    <h1>MyStore</h1>
    <div class="search-box">
        <input type="text" placeholder="Search products...">
    </div>
    <div>Cart 🛒</div>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">Electronics</a>
    <a href="#">Fashion</a>
    <a href="#">Deals</a>
</nav>

<section class="products">

    <div class="product">
        <img src="https://via.placeholder.com/200" alt="Product">
        <h3>Product 1</h3>
        <p>$50</p>
        <button onclick="addToCart('Product 1')">Add to Cart</button>
    </div>

    <div class="product">
        <img src="https://via.placeholder.com/200" alt="Product">
        <h3>Product 2</h3>
        <p>$30</p>
        <button onclick="addToCart('Product 2')">Add to Cart</button>
    </div>

    <div class="product">
        <img src="https://via.placeholder.com/200" alt="Product">
        <h3>Product 3</h3>
        <p>$80</p>
        <button onclick="addToCart('Product 3')">Add to Cart</button>
    </div>

    <div class="product">
        <img src="https://via.placeholder.com/200" alt="Product">
        <h3>Product 4</h3>
        <p>$20</p>
        <button onclick="addToCart('Product 4')">Add to Cart</button>
    </div>

</section>

<footer>
    <p>© 2026 MyStore. All rights reserved.</p>
</footer>

<script>
    function addToCart(productName) {
        alert(productName + " added to cart!");
    }
</script>

</body>
</html>
